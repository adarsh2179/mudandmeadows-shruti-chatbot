# ==============================================================================
# Mud & Meadows Resort AI Concierge - Environment Configuration
# ==============================================================================

# Server Settings
PORT=8000
ENVIRONMENT=development
COMPANY_NAME=Mud & Meadows

# Resort Backend API
RESORT_API_BASE_URL=https://mudandmeadows-api-742259178550.asia-south1.run.app

# Free GenAI Keys
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# Get your free key at: https://console.groq.com/
# Used for Whisper Large-v3 multilingual audio translation (Hindi, Bhojpuri, Kannada, etc.)
GROQ_API_KEY=your_groq_api_key_here

# Free Notification Services (Email & WhatsApp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=concierge@mudandmeadows.in
RESORT_WHATSAPP_NUMBER=919876543210

# Razorpay Payment Credentials (use Test Mode keys during development)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Cross-Origin Resource Sharing (CORS) - Comma-separated list of allowed website domains
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://mudandmeadows.in,https://www.mudandmeadows.in
